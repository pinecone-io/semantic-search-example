{
  "name": "pinecone-semantic-search",
  "version": "0.0.1",
  "description": "Example Node.js/TypeScript app demonstrating semantic search over a CSV dataset using Pinecone.",
  "keywords": [
    "pinecone",
    "vector-search",
    "semantic-search",
    "typescript",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinecone-io/semantic-search-example.git"
  },
  "license": "MIT",
  "author": "Roie Schwaber-Cohen",
  "type": "module",
  "scripts": {
    "clean": "rimraf ./build",
    "build": "npm-run-all format lint && tsc",
    "start": "node build/src",
    "test": "vitest run --retry 5",
    "dev": "ts-node src",
    "lint": "eslint src",
    "format": "npx prettier --write src",
    "format:check": "npx prettier --check src"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^8.2.0",
    "@xenova/transformers": "2.0.1",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.0.3",
    "onnxruntime-node": "^1.14.0",
    "papaparse": "^5.6.0",
    "uuid": "^14.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.0",
    "@types/node": "^20.2.3",
    "@types/papaparse": "^5.3.7",
    "@types/uuid": "^9.0.1",
    "@types/yargs": "^17.0.24",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3"
  }
}
